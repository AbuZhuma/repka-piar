    "support": {
      "title": "Support",
      "subtitle": "FAQ and Repka team contacts",
      "faq_title": "Frequently asked",
      "faq_items": [
        {
          "q": "How does verification work?",
          "a": "After you complete the form we receive your application and call you for 30 minutes within 24 hours. We verify diplomas via photo and discuss your experience, then publish the profile."
        },
        {
          "q": "How do I update my contacts or prices?",
          "a": "Cabinet → My profile. Each section is saved independently — click Save inside the section after editing."
        },
        {
          "q": "Does Repka take a cut?",
          "a": "Zero. All lesson money stays with you. Repka is a marketplace; we only connect you to students."
