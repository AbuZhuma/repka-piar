# Production environment for repka.school.
#
# Copy to .env.production on the server (NEVER commit the real one).
# All "?required" vars must be set or `docker compose up` will refuse to start.

# ---------------------------------------------------------------------- Domain
PUBLIC_SITE_URL=https://repka.school
PUBLIC_API_URL=https://repka.school
CORS_ORIGIN=https://repka.school

# Image tag for backend/frontend builds (use git short SHA for reproducible deploys).
IMAGE_TAG=latest

# -------------------------------------------------------------------- Postgres
POSTGRES_USER=repka
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=repka
POSTGRES_HOST_PORT=5436

# ----------------------------------------------------------------------- Redis
REDIS_HOST_PORT=6382
REDIS_MAXMEMORY=128mb
CACHE_TTL_SECONDS=60

# --------------------------------------------------------------------- Backend
BACKEND_HOST_PORT=8086
RUST_LOG=info,backend=info
# 32+ bytes of randomness. Generate: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
# Used to hash IPs before storing analytics (privacy). Generate the same way.
IP_HASH_SALT=change_me_to_a_long_random_salt

# Default admin auto-created on first start. Change password immediately after first login.
ADMIN_EMAIL=admin@repka.school
ADMIN_PASSWORD=change_me_admin_password

# -------------------------------------------------------------------- Frontend
FRONTEND_HOST_PORT=3006

# ------------------------------------------------------- Email (SMTP / Resend)
# Leave SMTP_HOST empty to disable transactional emails (registration will still
# create accounts; verification just won't get sent).
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_replace_with_real_resend_key
SMTP_FROM=noreply@abuzhuma.com
